# KANUM – contoh variabel lingkungan. Salin ke `.env` (gitignored) lalu isi nilai asli.

# Dipakai browser + server (aman untuk publik).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# HANYA server / skrip lokal. JANGAN pernah diekspos ke client.
# Dipakai scripts/restore-legacy-content.mjs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kredensial akun admin untuk harness E2E lokal (.freebuff/e2e.sh).
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=your-e2e-admin-password
